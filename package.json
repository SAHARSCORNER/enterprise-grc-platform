{
  "name": "enterprise-grc-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm --prefix shared run build && npm --prefix client run build && npm --prefix server run build",
    "start": "npm --prefix server run start",
    "dev": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "seed": "npm --prefix server run prisma:seed",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "docker:up": "docker compose -f docker/docker-compose.yml up --build"
  }
}
